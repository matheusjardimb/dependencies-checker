{
  "name": "dependencies-checker",
  "version": "1.2.0",
  "description": "JS dependencies checker",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/matheusjardimb/dependencies-checker"
  },
  "keywords": [
    "GitHub",
    "Actions",
    "JavaScript",
    "Dependencies"
  ],
  "author": {
    "name": "Matheus Jardim Bernardes",
    "url": "https://matheusjardimb.com/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/matheusjardimb/dependencies-checker/issues"
  },
  "homepage": "https://github.com/matheusjardimb/dependencies-checker#readme",
  "main": "dist/index.js",
  "files": [
    "dist",
    "action.yml"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "pre-commit.install": "husky",
    "build": "tsc",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "package": "ncc build lib/index.js -o dist --source-map --license LICENSE.md",
    "test": "jest",
    "all": "npm run build && npm run format && npm run lint && npm run package && npm test",
    "prepack": "npm run build && npm run package"
  },
  "dependencies": {
    "@actions/core": "2.0.3",
    "find-duplicated-property-keys": "1.2.9",
    "tinyglobby": "0.2.17"
  },
  "devDependencies": {
    "@types/find-duplicated-property-keys": "1.1.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vercel/ncc": "0.45.0",
    "eslint": "10.13.0",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jest": "29.17.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3"
  },
  "bin": "./dist/index.js"
}
